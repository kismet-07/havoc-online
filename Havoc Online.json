    "events": [{
      "type": "BuiltinCommonInstructions::JsCode",
      "inlineCode": "const player = runtimeScene.getObjects('New3DModel')[0];\nif (!player) return;\n\nconst dt = gdjs.evtTools.runtimeScene.getElapsedTimeInSeconds(runtimeScene);\nconst input = gdjs.evtTools.input;\nconst left = input.isKeyPressed(runtimeScene, 'a');\nconst right = input.isKeyPressed(runtimeScene, 'd');\nconst forward = input.isKeyPressed(runtimeScene, 'w');\nconst backward = input.isKeyPressed(runtimeScene, 's');\nconst running = input.isKeyPressed(runtimeScene, 'LShift') || input.isKeyPressed(runtimeScene, 'RShift');\n\nlet moveX = 0;\nlet moveY = 0;\nif (left) moveX -= 1;\nif (right) moveX += 1;\nif (forward) moveY += 1;\nif (backward) moveY -= 1;\n\nconst moving = moveX !== 0 || moveY !== 0;\nif (!moving) {\n  if (player.getAnimationName() !== 'Idle') player.setAnimationName('Idle');\n  return;\n}\n\nconst length = Math.sqrt(moveX * moveX + moveY * moveY);\nmoveX /= length;\nmoveY /= length;\nconst speed = running ? 600 : 300;\nplayer.setX(player.getX() + moveX * speed * dt);\nplayer.setY(player.getY() + moveY * speed * dt);\n\nconst targetAngle = Math.atan2(moveY, moveX) * 180 / Math.PI;\nplayer.setAngle(targetAngle);\n\nconst animation = running ? 'Run' : 'Walk';\nif (player.getAnimationName() !== animation) player.setAnimationName(animation);",
